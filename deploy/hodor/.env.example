# === VK (обязательно) ===
TOKEN=
BOT_CHAT_ID=
ADMIN_ID=

# === Нейросеть (рекомендуется для Ходора) ===
AI_ENABLED=true
AI_MODE=standalone
AI_PROVIDER=openrouter
AI_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
# POLZA_API_KEY=

# Промпт Ходора (можно не менять)
AI_SYSTEM_PROMPT=Ты Ходор из «Игры престолов». Отвечай в образе персонажа: в основном «Ходор» или «Hodor», иногда короткие фразы из 1–3 слов. Ты добрый, преданный, защищаешь друзей. Не используй сложные предложения. На русском чаще «Ходор», редко «Хо-дор» или «Ходор!». Если просят выключить бота — action bot_off, включить — bot_on, помощь — help.

# === Сервис ===
HEALTH_PORT=3010
DEBUG_MODE=false
